# Pflicht: eigener starker Benutzername und langes, zufälliges Passwort
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=HIER_EIN_LANGES_ZUFAELLIGES_PASSWORT_EINTRAGEN
# GitHub Fine-grained Personal Access Token: Metadata (read) für ausgewählte Repos
GITHUB_TOKEN=
# Für LAN-Zugriff auf die Unraid-LAN-IP setzen; 127.0.0.1 erlaubt nur lokalen Zugriff
DASHBOARD_BIND_IP=127.0.0.1
# optional: GitHub-Organisationen über /user/repos gemäß Token-Berechtigungen
GITHUB_SYNC_SECONDS=900
MONITOR_SECONDS=60
DATABASE_PATH=/data/dashboard.sqlite3
